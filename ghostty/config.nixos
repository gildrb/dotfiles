theme = Death Note

font-family = Ioskeley Mono
font-size = 15
# Keep the same appearance on Linux. Native Ghostty terminfo is installed
# with the per-user ghostty profile.
term = xterm-ghostty
background-opacity = 0.95
background-blur = true
background-opacity-cells = true
keybind = cmd+w=close_surface
keybind = shift+cmd+t=new_tab
keybind = ctrl+shift+t=new_tab

keybind = shift+cmd+n=new_window
keybind = shift+cmd+w=close_tab:this
keybind = cmd+v=paste_from_clipboard
keybind = ctrl+v=paste_from_clipboard
keybind = ctrl+shift+v=paste_from_clipboard
keybind = ctrl+digit_1=csi:49;5u
keybind = ctrl+digit_2=csi:50;5u
keybind = ctrl+digit_3=csi:51;5u
keybind = ctrl+digit_4=csi:52;5u
keybind = ctrl+digit_5=csi:53;5u
keybind = ctrl+digit_6=csi:54;5u
keybind = ctrl+digit_7=csi:55;5u
keybind = ctrl+digit_8=csi:56;5u
keybind = ctrl+digit_9=csi:57;5u
keybind = ctrl+1=csi:49;5u
keybind = ctrl+2=csi:50;5u
keybind = ctrl+3=csi:51;5u
keybind = ctrl+4=csi:52;5u
keybind = ctrl+5=csi:53;5u
keybind = ctrl+6=csi:54;5u
keybind = ctrl+7=csi:55;5u
keybind = ctrl+8=csi:56;5u
keybind = ctrl+9=csi:57;5u
