{
  "onboardingShown": false,
  "quietStartup": true,
  "rlmMaxDepth": 2,
  "theme": "dusk-apple",
  "steeringMode": "one-at-a-time",
  "followUpMode": "one-at-a-time",
  "showHardwareCursor": true,
  "enableSkillCommands": true,

  "telemetry": {
    "enabled": false,
    "noticeShown": false
  },

  "agentTraces": {
    "enabled": false
  },

  "autoRefine": {
    "enabled": true
  },

  "markdown": {
    "mermaid": "final"
  },

  "images": {
    "blockImages": false,
    "autoResize": true
  },

  "terminal": {
    "showImages": true,
    "clearOnShrink": true,
    "fullscreen": true
  },

  "compaction": {
    "enabled": true,
    "reserveTokens": 16384,
    "keepRecentTokens": 20000,
    "agentCallable": false
  },

  "memory": {
    "model": "anthropic/claude-sonnet-5-5",
    "thinking": "medium"
  },

  "retry": {
    "enabled": true,
    "maxRetries": 3,
    "baseDelayMs": 1500,
    "provider": {
      "maxRetryDelayMs": 15000
    }
  },

  "mcpServers": {
    "figma": {
      "type": "http",
      "url": "https://mcp.figma.com/mcp",
      "oauth": true
    }
  }
}
