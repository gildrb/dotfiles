{
  "agent": {
    "default_model": {
      "effort": "low",
      "enable_thinking": true,
      "model": "gpt-5.5",
      "provider": "zed.dev"
    },
    "default_profile": "allow-all",
    "dock": "right",
    "favorite_models": [],
    "flexible": true,
    "model_parameters": [],
    "profiles": {
      "allow-all": {
        "context_servers": {},
        "enable_all_context_servers": false,
        "name": "Allow all",
        "tools": {
          "edit_file": true
        }
      }
    },
    "sidebar_side": "right",
    "tool_permissions": {
      "tools": {
        "terminal": {
          "default": "confirm"
        }
      }
    }
  },
  "agent_servers": {},
  "auto_install_extensions": {
    "assembly": true,
    "css-variables": true,
    "git-firefly": true,
    "html": true,
    "html-snippets": true,
    "java": true,
    "material-icon-theme": true,
    "python-snippets": true,
    "rust-snippets": true,
    "swift": true,
    "toml": true,
    "typescript-snippets": true
  },
  "autosave": "off",
  "autoscroll_on_clicks": false,
  "base_keymap": "Zed",
  "buffer_font_family": "Ioskeley Mono",
  "buffer_font_size": 15.0,
  "buffer_line_height": "standard",
  "close_panel_on_toggle": true,
  "collaboration_panel": {
    "dock": "right"
  },
  "confirm_quit": true,
  "context_servers": {
    "posthog": {
      "enabled": false,
      "settings": {}
    }
  },
  "current_line_highlight": "all",
  "diagnostics": {
    "inline": {
      "enabled": true,
      "padding": 3,
      "update_debounce_ms": 200
    }
  },
  "disable_ai": false,
  "edit_predictions": {
    "open_ai_compatible_api": {
      "api_url": "https://api.z.ai/api/coding/paas/v4",
      "model": "glm-5.1"
    },
    "provider": "open_ai_compatible_api"
  },
  "format_on_save": "on",
  "git_panel": {
    "dock": "right"
  },
  "gutter": {
    "bookmarks": false,
    "breakpoints": false,
    "folds": false,
    "line_numbers": true,
    "runnables": false
  },
  "hard_tabs": false,
  "icon_theme": {
    "dark": "Material Icon Theme",
    "light": "Zed (Default)",
    "mode": "dark"
  },
  "indent_guides": {
    "enabled": false
  },
  "inline_code_actions": false,
  "language_models": {
    "openai_compatible": {
      "z-ai": {
        "api_url": "https://api.z.ai/api/coding/paas/v4",
        "available_models": [
          {
            "max_tokens": 128000,
            "name": "glm-5.1"
          }
        ]
      }
    }
  },
  "languages": {
    "Assembly": {
      "language_servers": [
        "!asm-lsp",
        "..."
      ]
    },
    "C": {
      "enable_language_server": true,
      "language_servers": [
        "clangd",
        "..."
      ]
    },
    "C++": {
      "enable_language_server": true,
      "language_servers": [
        "clangd",
        "..."
      ]
    },
    "Go": {
      "enable_language_server": true,
      "language_servers": [
        "gopls",
        "..."
      ]
    },
    "YAML": {
      "language_servers": [
        "yaml-language-server",
        "..."
      ]
    }
  },
  "minimap": {
    "show": "never"
  },
  "outline_panel": {
    "dock": "left"
  },
  "project_panel": {
    "default_width": 240,
    "dock": "left",
    "entry_spacing": "standard",
    "file_icons": false,
    "folder_icons": false,
    "starts_open": false
  },
  "preview_tabs": {
    "enabled": false
  },
  "proxy": "",
  "relative_line_numbers": "enabled",
  "restore_on_startup": "last_workspace",
  "scroll_beyond_last_line": "vertical_scroll_margin",
  "scrollbar": {
    "show": "never"
  },
  "show_edit_predictions": false,
  "show_whitespaces": "none",
  "show_wrap_guides": false,
  "soft_wrap": "none",
  "status_bar": {
    "active_language_button": false,
    "cursor_position_button": true,
    "show_active_file": true
  },
  "ssh_connections": [
    {
      "host": "hephaistos",
      "nickname": "hephaistos",
      "projects": [
        {
          "paths": [
            "/srv/agents/code",
            "/srv/agents/repos",
            "/srv/agents/worktrees"
          ]
        }
      ],
      "upload_binary_over_ssh": true,
      "username": "gilrodrigues"
    },
    {
      "host": "cedalion",
      "nickname": "Cedalion NAS",
      "upload_binary_over_ssh": false,
      "username": "gildrb"
    }
  ],
  "tab_bar": {
    "show": false
  },
  "tab_size": 2,
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "terminal": {
    "default_width": 960,
    "dock": "right",
    "flexible": false,
    "font_family": "Ioskeley Mono",
    "font_size": 15.0,
    "line_height": "standard",
    "option_as_meta": true,
    "shell": "system",
    "starts_open": false
  },
  "theme": {
    "dark": "Death Note",
    "light": "Death Note",
    "mode": "dark"
  },
  "title_bar": {
    "show_menus": true
  },
  "toolbar": {
    "agent_review": false,
    "breadcrumbs": false,
    "quick_actions": false,
    "selections_menu": false
  },
  "ui_font_size": 16,
  "use_smartcase_search": true,
  "vertical_scroll_margin": 8,
  "horizontal_scroll_margin": 8,
  "vim": {
    "default_mode": "normal",
    "highlight_on_yank_duration": 150,
    "toggle_relative_line_numbers": false,
    "use_regex_search": true,
    "use_smartcase_find": true,
    "use_system_clipboard": "always"
  },
  "vim_mode": true,
  "preferred_line_length": 100
}
