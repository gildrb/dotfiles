{
  "_config_version": 39,
  "browser": {
    "cloud_provider": "local",
    "engine": "chrome",
    "headed": false
  },
  "custom_providers": [
    {
      "key_env": "QWEN_API_KEY",
      "models": {
        "qwen3.8-27b": {
          "context_length": 24576
        }
      },
      "name": "local"
    }
  ],
  "display": {
    "interface": "tui",
    "skin": "death-note",
    "personality": "concise",
    "show_reasoning": false,
    "platforms": {
      "telegram": {
        "tool_progress": "off",
        "interim_assistant_messages": false,
        "long_running_notifications": true,
        "busy_ack_detail": false,
        "busy_steer_ack_enabled": false,
        "cleanup_progress": true
      }
    }
  },
  "mcp_servers": {
    "fff": {
      "command": "/run/current-system/sw/bin/nix",
      "args": [
        "run", "--offline", "--no-write-lock-file",
        "path:/home/gilrodrigues/Repos/dotfiles/hermes/fff"
      ],
      "connect_timeout": 60,
      "timeout": 120,
      "sampling": { "enabled": false }
    }
  },
  "model": {
    "context_length": 24576,
    "default": "qwen3.8-27b",
    "max_tokens": 8192,
    "provider": "custom:local"
  },
  "model_aliases": {
    "fast": {
      "model": "qwen3.8-27b",
      "provider": "custom:local"
    },
    "qwen": {
      "model": "qwen3.8-27b",
      "provider": "custom:local"
    }
  },
  "platform_toolsets": {
    "cli": [
      "terminal", "file", "web", "browser", "skills",
      "vision", "session_search", "clarify", "cronjob", "messaging"
    ],
    "telegram": [
      "terminal", "file", "web", "browser", "skills",
      "vision", "session_search", "clarify", "cronjob", "messaging"
    ]
  },
  "terminal": {
    "backend": "local"
  },
  "web": {
    "backend": "firecrawl",
    "extract_backend": "firecrawl",
    "search_backend": "firecrawl",
    "use_gateway": false
  },
  "security": {
    "redact_secrets": true
  },
  "privacy": {
    "redact_pii": true
  },
  "plugins": {
    "enabled": [
      "optmem-startup"
    ]
  },
  "hooks": {
    "output_spill": {
      "max_chars": 65536
    }
  }
}
