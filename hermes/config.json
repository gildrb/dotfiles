{
  "_config_version": 49,
  "agent": {
    "reasoning_effort": "xhigh",
    "max_turns": 150,
    "auto_recovery_cycles": 8,
    "execution_guidance": false,
    "tool_use_enforcement": false,
    "environment_probe": false
  },
  "approvals": {
    "mode": "manual",
    "destructive_slash_confirm": false
  },
  "auxiliary": {
    "transient_retries": 6,
    "background_review": {
      "enabled": false
    },
    "compression": {
      "timeout": 600
    },
    "title_generation": {
      "model_upgrade_enabled": false
    }
  },
  "browser": {
    "cloud_provider": "local",
    "engine": "chrome",
    "headed": false
  },
  "compression": {
    "enabled": true,
    "threshold": 0.75
  },
  "custom_providers": [
    {
      "extra_body": {
        "max_tokens": 32768
      },
      "key_env": "QWEN_API_KEY",
      "models": {
        "qwen3.8-27b": {
          "context_length": 262144,
          "supports_vision": false
        }
      },
      "name": "local"
    }
  ],
  "database": {
    "synchronous": "NORMAL"
  },
  "display": {
    "interface": "tui",
    "skin": "dusk-apple",
    "personality": "concise",
    "show_reasoning": false,
    "platforms": {
      "telegram": {
        "tool_progress": "off",
        "interim_assistant_messages": false,
        "long_running_notifications": true,
        "busy_ack_detail": false,
        "busy_steer_ack_enabled": false,
        "cleanup_progress": true
      }
    }
  },
  "mcp_servers": {
    "fff": {
      "connect_timeout": 60,
      "timeout": 120,
      "sampling": { "enabled": false }
    }
  },
  "model": {
    "context_length": 262144,
    "default": "qwen3.8-27b",
    "key_env": "QWEN_API_KEY",
    "provider": "custom:local"
  },
  "model_aliases": {
    "fast": {
      "model": "qwen3.8-27b",
      "provider": "custom:local"
    },
    "qwen": {
      "model": "qwen3.8-27b",
      "provider": "custom:local"
    }
  },
  "platform_toolsets": {
    "cli": [
      "terminal", "file", "web", "browser", "skills",
      "session_search", "clarify", "cronjob"
    ],
    "cron": [
      "terminal", "file", "web", "browser", "skills", "session_search"
    ],
    "telegram": [
      "terminal", "file", "web", "browser", "skills",
      "session_search", "clarify", "cronjob"
    ]
  },
  "terminal": {
    "backend": "local"
  },
  "tools": {
    "tool_search": {
      "enabled": "off"
    }
  },
  "web": {
    "backend": "firecrawl",
    "extract_backend": "firecrawl",
    "search_backend": "firecrawl",
    "use_gateway": false
  },
  "security": {
    "allow_lazy_installs": false,
    "redact_secrets": true
  },
  "privacy": {
    "redact_pii": true
  },
  "plugins": {
    "enabled": [
      "optmem-startup"
    ]
  },
  "skills": {
    "auto_load": [
      "i-have-adhd"
    ]
  },
  "hooks": {
    "output_spill": {
      "max_chars": 65536
    }
  }
}
