
set  -g default-terminal "screen"
set  -g base-index      0
setw -g pane-base-index 0





set -g status-keys emacs
set -g mode-keys   emacs







set  -g mouse             off
set  -g focus-events      off
setw -g aggressive-resize off
setw -g clock-mode-style  12
set  -s escape-time       10
set  -g history-limit     2000

# Use the default tmux prefix.
unbind -q C-a
set -g prefix C-b
bind C-b send-prefix

# Keep Ctrl+S available to terminal applications instead of flow control.
set-hook -g client-attached 'run-shell "stty -ixon < #{client_tty}"'

# Remove legacy prefix-free shortcuts when an existing tmux server reloads this file.
unbind -q -n C-j
unbind -q -n C-k
unbind -q -n C-1
unbind -q -n C-2
unbind -q -n C-3
unbind -q -n C-4
unbind -q -n C-5
unbind -q -n C-6
unbind -q -n C-7
unbind -q -n C-8
unbind -q -n C-9
unbind -q -n C-n
unbind -q -n C-q
unbind -q -n C-t
unbind -q -n C-w
unbind -q -n C-r
unbind -q -n C-d
unbind -q -n C-p
unbind -q -n C-Tab
unbind -q -n C-s
unbind -q -n C-o
unbind -q -n C-f
unbind -q -n C-x
unbind -q -n C-y

# Keep tmux actions behind Ctrl+B so Neovim and shells receive raw Ctrl keys.
bind h select-pane -L
bind j select-pane -D
bind k select-pane -U
bind l select-pane -R
bind N new-session -c "#{pane_current_path}"
bind Q confirm-before -p "kill-session #S? (y/n)" "kill-session -t \"#{session_name}\""
bind c new-window -c "#{pane_current_path}"
bind r command-prompt -I "#W" "rename-window '%%'"
bind s choose-tree -Zs
bind H split-window -h -c "#{pane_current_path}"
bind V split-window -v -c "#{pane_current_path}"
bind x confirm-before -p "kill-pane #P? (y/n)" kill-pane
bind o select-pane -t :.+

# Unbind Alt+Arrow so word-wise movement passes through to shell.
unbind -n M-Left
unbind -n M-Right

# Visual split aliases: Ctrl+B then | for side-by-side, or - for stacked.
bind | split-window -h -c "#{pane_current_path}"
bind - split-window -v -c "#{pane_current_path}"
unbind '"'
unbind %

set -g base-index 1
setw -g pane-base-index 1
set -g renumber-windows on
set -g automatic-rename off
set -g mouse on

# Performance: lowest possible input latency in tmux.
# escape-time 0 is critical -- the old default (500) adds artificial lag
# to every escape sequence / key. status-interval reduced to avoid
# unnecessary redraws.
set -s escape-time 0
set -g status-interval 10
set -g display-time 750
set -g set-titles off
set -g history-limit 100000
unbind -q -n MouseDown3Pane
unbind -q -n MouseDown3Status
unbind -q -n MouseDown3StatusLeft
unbind -q -n M-MouseDown3Pane
unbind -q -n M-MouseDown3Status
unbind -q -n M-MouseDown3StatusLeft
bind -T tree-mode MouseDown3Pane send-keys -X cancel
bind -T tree-mode MouseDown3Status send-keys -X cancel
bind -T tree-mode MouseDown3StatusLeft send-keys -X cancel

# Use tmux-256color for best compatibility and lower overhead over SSH.
# Falls back gracefully if the client lacks the terminfo.
set -g default-terminal "tmux-256color"
set -ga terminal-overrides ",*256col*:Tc"

# Show the machine class immediately when an SSH login lands in tmux.
set -g status on
set -g status-position bottom
set -g status-interval 5
set -g status-style "bg=#0a0a0a,fg=#a1a1a1"
set -g status-left-length 48
set -g status-left "#[bg=#5277c3,fg=#ffffff,bold] NixOS PC #[bg=#0a0a0a,fg=#a1a1a1] #S "
set -g status-right "#[fg=#676767]%Y-%m-%d #[fg=#ededed]%H:%M "
setw -g window-status-style "fg=#a1a1a1,bg=#0a0a0a"
setw -g window-status-current-style "bg=#5277c3,fg=#ffffff,bold"
setw -g window-status-format " #I:#W "
setw -g window-status-current-format " #I:#W "
set -g pane-border-style "fg=#3a3a3a"
set -g pane-active-border-style "fg=#5277c3"
set -g message-style "bg=#5277c3,fg=#ffffff,bold"
set -g mode-style "bg=#3a3a3a,fg=#ededed"

set -g extended-keys on
set -g extended-keys-format csi-u
setw -g mode-keys vi
