{
  "onboardingShown": true,
  "quietStartup": true,
  "telemetry": {
    "enabled": false,
    "noticeShown": true
  },
  "agentTraces": {
    "enabled": false
  },
  "autoRefine": {
    "enabled": false
  },
  "rlmMaxDepth": 1,
  "theme": "death-note",
  "steeringMode": "one-at-a-time",
  "followUpMode": "one-at-a-time",
  "showHardwareCursor": false,
  "enableSkillCommands": true,
  "images": {
    "blockImages": false
  },
  "terminal": {
    "showImages": true,
    "fullscreen": true
  },
  "compaction": {
    "enabled": true,
    "reserveTokens": 16384,
    "keepRecentTokens": 20000,
    "agentCallable": false
  },
  "retry": {
    "enabled": true,
    "maxRetries": 1,
    "baseDelayMs": 1500,
    "provider": {
      "timeoutMs": 180000,
      "maxRetries": 0,
      "maxRetryDelayMs": 15000
    }
  },
  "mcpServers": {
    "figma": {
      "type": "http",
      "url": "https://mcp.figma.com/mcp",
      "oauth": true
    }
  },
  "packages": [
    {
      "source": "git:github.com/gildrb/pi-fff-patched@8689459d1ea2ea80d6c38f5a32085204ef4926f2",
      "extensions": []
    }
  ],
  "npmCommand": [
    "sh",
    "-c",
    "export npm_config_prefix=\"$HOME/.prime/agent/npm-global\"; exec npm \"$@\"",
    "npm"
  ]
}
